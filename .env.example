# Port the API listens on (default 8080).
PORT=8080
# "production" makes missing required settings fatal at start-up.
APP_ENV=development

# Required in production.
# Postgres URL of a login role that may `set role` to anon/authenticated/service_role
# (on Supabase: the pooler URL for the postgres or authenticator user).
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
# Project JWT secret (Settings -> API -> JWT secret); at least 32 characters.
SUPABASE_JWT_SECRET=
# Shared key callers send as X-API-Key on /internal/* routes (webhooks, scheduler).
WEBHOOK_API_KEY=

# Supabase keys used by the auth wrappers and storage signing
# (POST /uploads answers 503 without SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Continue with Google: OAuth client from Google Cloud Console, read by the
# Supabase CLI for supabase/config.toml [auth.external.google] (on a hosted
# project set them under Authentication -> Providers -> Google instead).
# Authorised redirect URI: <SUPABASE_URL>/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional providers; leave empty to keep the feature disabled.
EMAIL_API_KEY=
EMAIL_FROM=
PUSH_API_KEY=
GIF_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Prefix of app links in emails (invite links: <base>communities/<id>/invite/<code>).
APP_LINK_BASE=intouch://

# Superuser Postgres URL used only by the database tests; each test creates and drops its own database.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres

# Deploy pipeline (scripts/deploy.sh).
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
DEPLOY_COMMAND=
